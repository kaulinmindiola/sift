# Copy to .env for local development (`.env` is git-ignored; never commit it).
# These values are harmless development defaults. Variables already set in the
# process environment (compose, CI) take precedence over this file.

# --- Django
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sift
DB_USER=sift
DB_PASSWORD=sift-dev-password

# --- Redis (broker, channel layer and tickets)
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO). The API signs URLs with the public endpoint.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=sift
S3_SECRET_KEY=sift-dev-secret
S3_BUCKET=sift
S3_REGION=us-east-1

# --- Limits and import (ImportSettings; defaults from the SRS)
MAX_FILE_BYTES=209715200
MAX_ROWS=2000000
BATCH_SIZE=5000
ERROR_RATE_THRESHOLD=0.05
MAX_STORED_ERRORS=10000
UPLOAD_URL_TTL_S=600
UPLOAD_EXPIRY_H=24
PREVIEW_TTL_H=24
REPORT_RETENTION_D=7

# --- Recovery
RESCUE_INTERVAL_S=30
HEARTBEAT_STALE_S=120
APPLY_LEASE_S=600
MAX_ATTEMPTS=3

# --- Live progress
PROGRESS_MIN_INTERVAL_MS=500
WS_TICKET_TTL_S=30
